{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Migración incremental: los módulos de lógica pura ya son .ts y se
    // chequean con `strict`; el resto de la app sigue en .js/.jsx y no se
    // chequea todavía (checkJs: false). Al convertir un archivo, cambiale la
    // extensión a .ts y listo: entra en el chequeo estricto sin tocar imports
    // (las rutas son sin extensión y Vite/Vitest resuelven .ts solo).
    "allowJs": true,
    "checkJs": false,

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
