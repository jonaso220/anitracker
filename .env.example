# Copiá este archivo a .env.local y completá tus valores.
# Las claves Web de Firebase y la API key de TMDB no son secretas en una app
# de navegador, pero .env* está en .gitignore igualmente.

# --- Firebase (opcional) ---
# Si no se configuran, la app usa el proyecto público compartido.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- TMDB (opcional, recomendado) ---
# Habilita búsqueda de películas/series con metadatos en español y
# "dónde ver" por país (Netflix, Disney+, etc. — datos de JustWatch).
# Registrate gratis en https://www.themoviedb.org/settings/api y pegá acá
# tu "API Key" (v3) o el "Token de acceso de lectura" (v4).
VITE_TMDB_API_KEY=

# --- Reporte de errores (opcional) ---
# Si la completás, la app manda un POST JSON con los errores no atrapados
# (errores globales, promesas rechazadas y los que captura ErrorBoundary) a ese
# endpoint: sirve una función serverless o un webhook propio. Sin esta variable
# no se manda nada.
# Formato: { app, kind, message, stack?, componentStack?, url, at }
VITE_ERROR_REPORT_URL=

# --- AniList: mandar tu progreso (opcional) ---
# Habilita "Conectar con AniList": la app manda a tu lista de AniList el estado,
# los episodios vistos y la nota de cada anime que cambies. Sin esta variable la
# opción no aparece.
# 1. Entrá a https://anilist.co/settings/developer y creá un "API Client".
# 2. En "Redirect URL" poné la URL exacta donde corre la app (p. ej.
#    https://tu-app.netlify.app/ o http://localhost:5173/ para desarrollo).
#    AniList acepta una sola por cliente: creá un cliente por cada entorno.
# 3. Pegá acá el "Client ID" (un número). No hace falta el "Client Secret":
#    se usa el implicit grant, y el client id no es secreto.
VITE_ANILIST_CLIENT_ID=
